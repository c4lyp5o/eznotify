# Copy to .env and chmod 600 .env. Never commit real values.
# Generate admin token: openssl rand -hex 32
EZNOTIFY_ADMIN_TOKEN=
# Generate encryption key: openssl rand -base64 32
# Keep this key with your database backup; losing it loses credentials.
EZNOTIFY_ENCRYPTION_KEY=
# Comma-separated exact HTTPS origins for self-hosted providers.
EZNOTIFY_OUTBOUND_ORIGINS=https://ntfy.example.com
# Exact SMTP host:port allowlist; empty denies all SMTP connections.
EZNOTIFY_SMTP_SERVERS=
PROXY_NETWORK=traefik_default
